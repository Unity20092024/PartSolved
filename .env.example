# Stage 1: disabled by default; production is blocked in code regardless of flags.
AI_ANALYSIS_ENABLED=false
AI_LOCAL_REVIEW=false
AI_ALLOWED_ORIGIN=http://127.0.0.1:3000
OPENAI_VISION_MODEL=gpt-5.4-mini-2026-03-17
OPENAI_API_KEY=
# Generate three independent random secrets, at least 32 characters each.
AI_REVIEW_ACCESS_TOKEN=
AI_SESSION_SECRET=
AI_IP_HASH_SECRET=
# Reuse the blog's existing/future Supabase project; do not create a second project.
# The server accepts NEXT_PUBLIC_SUPABASE_URL instead of SUPABASE_URL if already set.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Blog: reuse that same Supabase project. The publishable key is intentionally public.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional alternative to SUPABASE_URL, not a second project:
NEXT_PUBLIC_SUPABASE_URL=
# Exact origin; use http://127.0.0.1:3000 for local development, or the exact preview origin.
BLOG_ADMIN_ORIGIN=https://www.partsolved.com
# Enable only after approved migrations, admin membership and access checks pass.
BLOG_WRITES_ENABLED=false
# Enable only after a recurring publication job is configured and tested.
BLOG_SCHEDULER_READY=false
# $1/day and $10/month are enforced in code AND database constraints, not public env.
# Test/evaluation credentials must be separate from production. No secret belongs in NEXT_PUBLIC_*.
